{
  "run": {
    "dry_run_default": true,
    "max_new_leads_per_run": 50,
    "timezone": "Asia/Shanghai",
    "provider": "scweet",
    "fixture_path": "fixtures/sample_posts.json",
    "raw_fetch_limit": 240
  },
  "scweet": {
    "daily_requests_limit": 80,
    "daily_tweets_limit": 900,
    "concurrency": 1,
    "n_splits": 1,
    "requests_per_min": 6,
    "min_delay_s": 5,
    "max_empty_pages": 1,
    "api_page_size": 20
  },
  "x": {
    "queries": [
      "(I OR my OR help OR stuck OR error) (Supabase OR Vercel OR database OR backend OR \"API key\" OR RLS OR Auth) (app OR website OR SaaS OR MVP OR project OR \"side project\")",
      "(\"I built\" OR \"I'm building\" OR \"I made\" OR \"I used AI\" OR \"vibe coding\") (app OR website OR SaaS OR MVP OR project) (backend OR database OR login OR deploy OR Supabase OR Vercel)",
      "(Cursor OR \"Claude Code\" OR Lovable OR Bolt OR Trae OR WorkBuddy OR \"vibe coding\") (backend OR database OR Supabase OR Vercel OR deploy OR login) (stuck OR error OR failed OR help OR tedious OR annoying)",
      "(\"data not saving\" OR \"can't save data\" OR \"database error\" OR \"RLS policy\" OR \"environment variable\") (AI OR Cursor OR Lovable OR Vercel OR Supabase OR project)",
      "(\"Vercel deploy failed\" OR \"Vercel environment variables\" OR \"Supabase auth\" OR \"Supabase RLS\" OR \"login signup\") (help OR stuck OR error OR failed OR \"can't figure out\")",
      "(\"indie hacker\" OR \"side project\" OR MVP OR SaaS) (backend OR database OR auth OR deploy OR Supabase OR Vercel) (stuck OR annoying OR tedious OR help OR error)",
      "Supabase database lang:en",
      "Supabase auth lang:en"
    ],
    "lang": "en",
    "result_type": "Latest",
    "lookback_hours": 720,
    "read_only": true
  },
