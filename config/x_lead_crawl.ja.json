{
  "run": {
    "dry_run_default": true,
    "max_new_leads_per_run": 50,
    "timezone": "Asia/Shanghai",
    "provider": "scweet",
    "fixture_path": "fixtures/sample_posts.json",
    "raw_fetch_limit": 240
  },
  "scweet": {
    "daily_requests_limit": 80,
    "daily_tweets_limit": 900,
    "concurrency": 1,
    "n_splits": 1,
    "requests_per_min": 6,
    "min_delay_s": 5,
    "max_empty_pages": 1,
    "api_page_size": 20
  },
  "x": {
    "queries": [
      "(助けて OR 教えて OR 詰まった OR エラー OR 失敗) (Supabase OR Vercel OR データベース OR DB OR バックエンド OR \"API Key\" OR RLS OR Auth) (アプリ OR Webサイト OR SaaS OR MVP OR プロジェクト OR 個人開発)",
      "(\"AIで作った\" OR \"AIで作って\" OR \"Cursorで\" OR \"vibe coding\") (アプリ OR Webサイト OR SaaS OR MVP OR プロジェクト) (バックエンド OR データベース OR ログイン OR デプロイ OR Supabase OR Vercel)",
      "(Cursor OR \"Claude Code\" OR Lovable OR Bolt OR Trae OR WorkBuddy OR \"vibe coding\") (バックエンド OR データベース OR Supabase OR Vercel OR デプロイ OR ログイン) (詰まった OR エラー OR 失敗 OR 助けて OR 面倒 OR 煩雑)",
      "(\"データ保存\" OR \"保存できない\" OR \"データベースエラー\" OR \"RLS 権限\" OR \"環境変数\") (AI OR Cursor OR Lovable OR Vercel OR Supabase OR プロジェクト)",
      "(\"Vercel デプロイ 失敗\" OR \"Vercel 環境変数\" OR \"Supabase auth\" OR \"Supabase RLS\" OR \"ログイン 実装\") (助けて OR 教えて OR 詰まった OR エラー OR わからない)",
      "(\"個人開発\" OR MVP OR SaaS) (バックエンド OR データベース OR 認証 OR デプロイ OR Supabase OR Vercel) (わからない OR 詰まった OR 面倒 OR 助けて OR エラー)",
      "Supabase データベース lang:ja",
      "Supabase 認証 lang:ja"
    ],
    "lang": "ja",
    "result_type": "Latest",
    "lookback_hours": 720,
    "read_only": true
  },
  "filters": {
    "high_priority_keywords": [
      "AI アプリ データ保存",
      "AI Webサイト データ保存",
      "AI プロジェクト バックエンド",
