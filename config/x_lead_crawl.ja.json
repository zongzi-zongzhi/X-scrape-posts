        "complaint_tone"
      ]
    ],
    "min_score": 6,
    "language_filter": {
      "script": "japanese",
      "min_japanese_chars": 6
    },
    "relaxed_min_score": 4,
    "relaxed_must_match_groups": [
      "backend_pain"
    ],
    "relaxed_must_match_any_group_sets": [
      [
        "project_context"
      ],
      [
        "help_tone",
        "complaint_tone",
        "first_person"
      ]
    ]
  },
  "dedupe": {
    "state_path": "data/seen_posts_ja.json",
    "keys": [
      "post_url",
      "post_id",
      "author_handle_text_hash"
    ]
  },
  "no_reply_profile": {
    "path": "config/no_reply_profile.json",
    "training_inputs": [
      "data/no_reply_samples.jsonl"
    ],
    "min_phrase_count": 2
  },
  "outputs": {
    "root": "outputs/ja",
    "pointer_path": "outputs/x_leads_ja_pointer.json"
  },
  "lark": {
    "base_token": "",
    "table_id": "",
    "table_name": "X-日语",
    "required_fields": [
      "发布时间",
      "帖子名字",
      "帖子链接",
      "状态",
      "评论",
      "匹配关键词",
      "后续帖主回复",
      "回复情况",
      "二次评论",
      "其他"
    ],
    "human_only_fields": [
      "状态",
      "评论",
      "后续帖主回复",
      "回复情况",
      "二次评论",
      "其他"
    ],
    "default_status": ""
  }
